  "narrative": {
    "northStar": "One consultation, one place",
    "overview": "MedEdge uses restrained clinical typography, zinc surfaces and supplied pixel illustrations. Pixel heart, stethoscope and category marks identify workspaces and tasks; conventional text and forms carry clinical evidence. The care shell gives desktop navigation its own narrow rail and keeps the active task in one main column.\n\nThe hierarchy follows a short patient overview into dated visits and then into one report, prescription or note. Rules and whitespace separate content. Review detail expands where needed; the overview stays concise. Preserve the footer, account controls and both themes.",
    "keyCharacteristics": [
      "Pixel identity with readable English and Bengali clinical text.",
      "Flat zinc surfaces, restrained blue selection and semantic review colors.",
      "One patient or visit heading and a clear next action.",
      "Source evidence close to editable clinical content."
    ],
    "rules": [
      {
        "name": "The Semantic Color Rule",
        "body": "Status color accompanies explicit text; preserve the same meaning in both themes.",
        "section": "colors"
      },
      {
        "name": "The Clinical Text Rule",
        "body": "Keep medicine names, doses and authored evidence in readable text; pixel marks identify categories rather than replacing text.",
        "section": "typography"
      },
      {
        "name": "The Flat Visit Rule",
        "body": "Use separators and spacing for patient and visit lists; reserve contained surfaces for fields, notices or document tools that need them.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve pixel task marks, Geist, Bengali glyph coverage and both themes.",
      "**Do** give a patient or visit one main heading and a clear next action.",
      "**Do** keep source evidence accessible beside or behind the review pane.",
      "**Do** show status in words with visible focus, processing feedback and retries.",
      "**Do** keep the short health narrative separate from detailed sources and patient-reported medicines."
    ],
    "donts": [
      "**Don't** restore the old persistent patient directory or Summary/History/Add report tab structure in the care shell.",
      "**Don't** turn every visit row or narrative into a nested card.",
      "**Don't** expose raw FHIR bundles or model trace panels in either portal.",
      "**Don't** replace clinical labels with decorative pixel text or color-only status.",
      "**Don't** hide the reason publication or visit completion is unavailable."
    ]
  }
}
