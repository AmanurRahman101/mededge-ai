# Copy to .env and fill in. Never commit .env.

# Meta Model API key from https://dev.meta.ai
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1

# Role routing: comma-separated fallback chain of provider:model, tried in order.
# Providers: meta, glimmer, fireworks, baseten, modal, openrouter
# Example once Colab is up: ROLE_EXTRACTOR=glimmer:muse-glimmer,meta:muse-spark-1.3
ROLE_EXTRACTOR=meta:muse-spark-1.3
ROLE_STRUCTURER=meta:muse-spark-1.3
ROLE_AGENT=meta:muse-spark-1.3

# Muse Glimmer self-hosted on Colab. colab/glimmer_server.ipynb prints both values.
GLIMMER_BASE_URL=
GLIMMER_API_KEY=

# Hosted Muse Spark Open partners. Fill whichever approves credits.
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_API_KEY=
MODAL_BASE_URL=
MODAL_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# Segmentation: meta (Meta Model API) or local (open SAM 3.1 weights on this machine)
SAM_PROVIDER=meta
SAM_MODEL=sam-3.1

# Speech to text
VOICE_MODEL=muse-voice-transcribe-1.0

# Guards
APP_ENV=development
APP_BASE_URL=http://localhost:5173
# Only enable when all public requests pass through Render's trusted edge.
TRUST_RENDER_PROXY=false
# Development writes verification and recovery links to backend/var/mail/.
# Production requires a verified Resend sender, HTTPS APP_BASE_URL, and PostgreSQL.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
AUTH_EMAIL_DAILY_LIMIT=90
AUTH_EMAIL_MONTHLY_LIMIT=2500
DAILY_BUDGET_USD=8
CORS_ORIGINS=http://localhost:5173
ENABLE_DEV_ROUTES=false
DATABASE_URL=sqlite:///var/mededge.db
# Optional direct URL to the same database, used only by Alembic migrations.
# For Neon, keep DATABASE_URL pooled and set this to the direct connection URL.
DATABASE_URL_UNPOOLED=
RUNS_DIR=var/runs
HAPI_BASE_URL=https://hapi.fhir.org/baseR4
PSEUDONYM_SALT=change-me
SAM_LOCAL_CHECKPOINT=

# Public judge demo accounts (fictional data, hourly reset). Both emails plus a password of 12+ chars enable them.
# The password is shown on the sign-in page on purpose, so never reuse a real one.
DEMO_PATIENT_EMAIL=
DEMO_DOCTOR_EMAIL=
DEMO_PASSWORD=
